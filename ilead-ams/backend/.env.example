# ==============================================================================
# I-LEAD AMS Backend Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ==============================================================================

# Application
NODE_ENV=production
PORT=3001
APP_NAME=I-LEAD AMS
APP_VERSION=4.0.0

# Database - MongoDB
MONGODB_URI=mongodb://ilead_admin:password@localhost:27017/ilead_ams?authSource=admin
MONGO_USER=ilead_admin
MONGO_PASSWORD=secure_password_here
MONGO_DB=ilead_ams

# JWT & Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d
SESSION_TIMEOUT=3600

# Frontend URLs
FRONTEND_URL=https://ilead.yourdomain.com
CORS_ORIGIN=https://ilead.yourdomain.com
ALLOWED_ORIGINS=https://ilead.yourdomain.com,https://www.ilead.yourdomain.com

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@ilead.yourdomain.com
SMTP_FROM_NAME=I-LEAD AMS

# AWS S3 Configuration (Optional - for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ilead-ams-uploads

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# Security
ENABLE_HELMET=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PASSWORD_MIN_LENGTH=8
SESSION_SECRET=another_secret_for_sessions

# File Upload
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,csv,jpg,png,jpeg

# API Configuration
API_TIMEOUT_MS=30000
API_CACHE_ENABLED=true
API_CACHE_TTL=300

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_AUDIT_LOGGING=true
ENABLE_ANALYTICS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Redis Cache (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# External Services
SENTRY_DSN=
MIXPANEL_TOKEN=
