# Docker Environment Configuration
# Copy this file to .env.local and update with your values for local development

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ilead_ams
DB_SSL=false

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# JWT Configuration
JWT_SECRET=dev-secret-key-change-in-production-with-32-chars
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Super Admin Configuration
SUPER_ADMIN_EMAIL=hector.torres@i-leadusa.org
SUPER_ADMIN_PIN_PLAIN=071676

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=I-LEAD AMS <noreply@i-leadusa.org>

# SMS Configuration (Clearstream)
CLEARSTREAM_API_KEY=your-clearstream-api-key
CLEARSTREAM_ENDPOINT=https://api.getclearstream.com/v1/texts

# Document Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=/app/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=dev-session-secret-change-in-production
SESSION_MAX_AGE=86400000

# Optional: AWS S3 Configuration
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=ilead-ams-docs
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# Optional: Google Sheets Integration
# GOOGLE_SHEETS_API_KEY=your-key
# GOOGLE_SHEETS_SPREADSHEET_ID=your-sheet-id

# Optional: Make.com Webhook
# MAKE_WEBHOOK_URL=https://hook.us2.make.com/...
